# Insurance Management System - Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit the .env file with real secrets to version control.

# Application
APP_NAME=Insurance Management System
APP_VERSION=1.0.0
SERVER_PORT=8080

# Spring Datasource (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/insurance_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRATION_MS=86400000

# CORS (Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_INSURANCE=DEBUG
